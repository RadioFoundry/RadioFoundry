#
# runner-loop.sh's settings: copy to runner-1.env next to it (runner-N.env for more runners) and fill in. Nothing here is a secret; the runner's
# credentials are in STATE_DIR (mode 700), written once by `runner-loop.sh register`.
REPO=OWNER/OpenDigitalRadio
IMAGE=odr/ci-runner:latest
PROXY_IMAGE=odr/ci-proxy:latest
NAME=odr-ci-1
LABELS=odr-ci
# the job's workspace (emptied at the start of every job) and the registration (read-only to jobs)
WORK_DIR=/srv/odr-ci-runner/work
STATE_DIR=/srv/odr-ci-runner/state
# the internal network: pick a subnet no other network or LAN uses; the proxy gets a fixed address in it
SUBNET=172.31.250.0/28
PROXY_IP=172.31.250.2
CPUS=6
MEMORY=4g
PIDS=4096
