# Builder image for the csky-elf toolchain: Ubuntu 24.04 with what binutils, GCC 14 and newlib need to build.
# build.sh runs it with a host work directory on /work and tools/build-csky-toolchain.sh on /build.sh, so the build
# tree (peak about 4 GB) stays on the host's scratch disk instead of in image layers; the result goes into the CI
# image (Dockerfile). Build by hand:
#   docker build -t odr/csky-builder -f tools/docker/csky-toolchain/Dockerfile.build tools/docker/csky-toolchain
#   docker run --rm -v /scratch/odr-csky:/work -v $PWD/tools/build-csky-toolchain.sh:/build.sh:ro \
#       -e PREFIX=/work/csky-elf -e SRC=/work/src -e CLEAN=1 odr/csky-builder
FROM ubuntu:24.04
RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		build-essential curl ca-certificates xz-utils libgmp-dev libmpfr-dev libmpc-dev libisl-dev zlib1g-dev \
		texinfo bison flex \
	&& rm -rf /var/lib/apt/lists/*
ENV PREFIX=/work/csky-elf SRC=/work/src CLEAN=1
CMD ["bash", "/build.sh"]
